{
  "_note": "Registry snapshot supplied with the submission. Availability and API deployment IDs are not guaranteed. Defaults use provider endpoints; custom gateways require an explicit base URL override or --config. api_model optionally overrides the wire model name.",
  "defaults": {
    "temperature": 0,
    "max_output_tokens": 16384,
    "fps_ladder": [
      5,
      3,
      1
    ],
    "timeout_s": 900
  },
  "endpoints": {
    "dashscope": {
      "type": "chat",
      "protocol": "chat",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "base_url_env": "DASHSCOPE_BASE_URL",
      "key_env": "DASHSCOPE_API_KEY",
      "video_fps_field": "part",
      "base64_max_bytes": 7000000,
      "upload": "dashscope_oss",
      "extra_body": {
        "enable_thinking": false
      }
    },
    "mimo": {
      "type": "chat",
      "protocol": "chat",
      "base_url": "https://api.xiaomimimo.com/v1",
      "key_env": "MIMO_API_KEY",
      "video_fps_field": "part",
      "token_field": "max_completion_tokens",
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "base_url_env": "MIMO_BASE_URL"
    },
    "ark": {
      "type": "chat",
      "protocol": "chat",
      "base_url": "https://ark.cn-beijing.volces.com/api/v3",
      "key_env": "ARK_API_KEY",
      "video_fps_field": "video_url",
      "extra_body": {
        "thinking": {
          "type": "disabled"
        }
      },
      "base_url_env": "ARK_BASE_URL"
    },
    "gemini": {
      "type": "gemini",
      "protocol": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "key_env": "GEMINI_API_KEY",
      "base64_max_bytes": 20000000,
      "extra_generation_config": {
        "thinkingConfig": {
          "thinkingLevel": "low"
        }
      },
      "base_url_env": "GEMINI_BASE_URL"
    },
    "responses": {
      "type": "responses",
      "protocol": "responses",
      "base_url": "https://api.openai.com/v1",
      "key_env": "OPENAI_API_KEY",
      "max_images": 1500,
      "extra_body": {
        "reasoning": {
          "effort": "none"
        }
      },
      "base_url_env": "OPENAI_BASE_URL"
    }
  },
  "models": {
    "gemini-3.8-flash": {
      "name": "Gemini 3.8 Flash",
      "endpoint": "gemini",
      "source": "closed"
    },
